cabal-version: 2.2

name:           aoc
version:        0.1.0.0
synopsis:       Advent of Code solutions in Haskell
description:    Each puzzle is a standalone executable named aoc-<year>-<day>.
homepage:       https://github.com/beefyhalo/aoc#readme
bug-reports:    https://github.com/beefyhalo/aoc/issues
author:         Kevin Horlick
maintainer:     beefyhalo@gmail.com
copyright:      2024 Kevin Horlick
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/beefyhalo/aoc

-- Every puzzle shares one dependency set and one warning set. A new day only
-- needs its own four-line stanza below.
common puzzle
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
  build-depends:
      adjunctions
    , aeson
    , arithmoi
    , array
    , attoparsec
    , base >=4.7 && <5
    , bitvec
    , bytestring
    , comonad
    , constraints
    , containers
    , cryptohash-md5
    , data-fix
    , extra
    , free
    , heap
    , hmatrix
    , lens
    , linear
    , memory
    , mod
    , mono-traversable
    , monoidal-containers
    , mtl
    , nonempty-zipper
    , parallel
    , recursion-schemes
    , scientific
    , sized-grid
    , split
    , text
    , uniplate
    , vector
    , vector-space

